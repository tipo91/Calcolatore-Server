<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Calcolatore scontri D&D 5e (DMG 2014)</title>
<style>
:root{
  --bg:#f3f4f1;--surface:#fff;--ink:#1d2320;--muted:#5d6762;--line:#d5d9d4;
  --c0:#7a8580;--c1:#4f9a4a;--c2:#b89200;--c3:#d9762b;--c4:#c23a2e;--c5:#7d1612;--accent:#1f5c4a;
}
@media (prefers-color-scheme:dark){
  :root{--bg:#151a18;--surface:#1e2522;--ink:#e8ece9;--muted:#9aa5a0;--line:#33403b;--accent:#6fc4a6;--c2:#d1a300;--c5:#e0544a;}
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 Georgia,"Times New Roman",serif}
main{max-width:860px;margin:0 auto;padding:24px 16px 48px}
h1{font-size:1.7rem;margin:0 0 4px;line-height:1.2}
h2{font-size:1.1rem;margin:0 0 10px}
.sub{color:var(--muted);margin:0 0 24px;font-size:.95rem}
section{background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:16px;margin-bottom:16px}
.row{display:flex;gap:8px;align-items:center;margin-bottom:8px;flex-wrap:wrap}
label{font:.85rem system-ui,sans-serif;color:var(--muted)}
input,select,button{font:1rem system-ui,sans-serif;color:var(--ink);background:var(--bg);border:1px solid var(--line);border-radius:4px;padding:7px 9px}
input[type=number]{width:4.5rem}
select{min-width:5rem}
button{cursor:pointer}
button:hover{border-color:var(--accent)}
button:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid var(--accent);outline-offset:1px}
.del{padding:7px 11px;color:var(--muted)}
.add{margin-top:4px;color:var(--accent);border-style:dashed}
.xp{font:.85rem system-ui,sans-serif;color:var(--muted);margin-left:auto}
.verdict{font-size:1.5rem;margin:0 0 4px;font-weight:bold}
.calc{font:.92rem system-ui,sans-serif;color:var(--muted);margin:0 0 16px}
.bar{position:relative;height:18px;background:var(--bg);border:1px solid var(--line);border-radius:3px;margin:8px 0 20px;overflow:hidden}
.fill{height:100%;width:0;background:var(--accent);transition:width .25s}
.tick{position:absolute;top:0;bottom:0;width:2px;background:var(--surface)}
.grid{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}
.cell{border:1px solid var(--line);border-top:4px solid var(--k);border-radius:4px;padding:6px 8px;font:.85rem system-ui,sans-serif;opacity:.55}
.cell.on{opacity:1;background:var(--bg)}
.cell b{display:block;font-size:1.05rem;font-variant-numeric:tabular-nums}
.cell span{color:var(--muted)}
.note{font:.82rem/1.45 system-ui,sans-serif;color:var(--muted)}
@media(max-width:560px){.grid{grid-template-columns:repeat(2,1fr)}}
@media(prefers-reduced-motion:reduce){.fill{transition:none}}
</style>
</head>
<body>
<main>
<h1>Calcolatore scontri D&amp;D 5e (DMG 2014)</h1>
<p class="sub">Soglie di PE per livello con le fasce Facile, Medio, Difficile, Arduo e Letale, più il moltiplicatore per numero di creature.</p>

<section>
  <h2>Gruppo</h2>
  <div id="party"></div>
  <button class="add" id="addP">Aggiungi gruppo di PG</button>
</section>

<section>
  <h2>Creature</h2>
  <div id="mons"></div>
  <button class="add" id="addM">Aggiungi creatura</button>
</section>

<section aria-live="polite">
  <h2>Risultato</h2>
  <p class="verdict" id="verdict"></p>
  <p class="calc" id="calc"></p>
  <div class="bar" id="bar"><div class="fill" id="fill"></div></div>
  <div class="grid" id="grid"></div>
</section>

<p class="note">Le soglie sono la somma di quelle di ogni PG. Il moltiplicatore è quello della DMG 2014: ×1 per 1 creatura, ×1,5 per 2, ×2 per 3–6, ×2,5 per 7–10, ×3 per 11–14, ×4 per 15 o più. Con meno di 3 PG si sale di un gradino, con 6 o più si scende di un gradino. Se nel post «Calcolo Fight DMG14» ci sono varianti, modifica le costanti <code>T</code> e <code>STEPS</code> nello script.</p>
</main>

<script>
// Soglie PE per PG: [Facile, Medio, Difficile, Arduo, Letale]
const T={1:[50,75,100,125,150],2:[100,150,200,250,300],3:[150,225,400,475,550],4:[250,375,500,625,750],
5:[500,750,1100,1350,1600],6:[600,900,1400,1700,2000],7:[700,1100,1700,2050,2400],8:[900,1400,2100,2550,3000],
9:[1100,1600,2400,2950,3500],10:[1200,1900,2800,3400,4000],11:[1600,2400,3600,4400,5200],12:[2000,3000,4500,5500,6500],
13:[2200,3400,5100,6200,7300],14:[2500,3800,5700,6950,8200],15:[2800,4300,6400,7800,9200],16:[3200,4800,7200,8800,10400],
17:[4000,5900,8800,10800,12800],18:[4200,6300,9500,11600,13700],19:[4800,7300,10900,13300,15700],20:[5600,8500,12700,15500,21100]};
const NAMES=["Facile","Medio","Difficile","Arduo","Letale"];
const COL=["var(--c1)","var(--c2)","var(--c3)","var(--c4)","var(--c5)"];
const CR=[["0",10],["1/8",25],["1/4",50],["1/2",100],["1",200],["2",450],["3",700],["4",1100],["5",1800],["6",2300],["7",2900],["8",3900],["9",5000],["10",5900],["11",7200],["12",8400],["13",10000],["14",11500],["15",13000],["16",15000],["17",18000],["18",20000],["19",22000],["20",25000],["21",33000],["22",41000],["23",50000],["24",62000],["25",75000],["26",90000],["27",105000],["28",120000],["29",135000],["30",155000]];
const STEPS=[0.5,1,1.5,2,2.5,3,4,5];
const fmt=n=>n.toLocaleString("it-IT");
const mult=n=>n>=15?6:n>=11?5:n>=7?4:n>=3?3:n==2?2:1;

let party=[{n:4,l:5}], mons=[{i:4,q:2}];
const $=id=>document.getElementById(id);

function render(){
  $("party").innerHTML=party.map((p,k)=>`<div class="row">
    <label>PG <input type="number" min="1" max="20" value="${p.n}" data-p="${k}" data-f="n"></label>
    <label>livello <select data-p="${k}" data-f="l">${Object.keys(T).map(l=>`<option ${l==p.l?"selected":""}>${l}</option>`).join("")}</select></label>
    <button class="del" data-dp="${k}" aria-label="Rimuovi gruppo">×</button></div>`).join("");
  $("mons").innerHTML=mons.map((m,k)=>`<div class="row">
    <label>quantità <input type="number" min="1" max="99" value="${m.q}" data-m="${k}" data-f="q"></label>
    <label>GS <select data-m="${k}" data-f="i">${CR.map((c,i)=>`<option value="${i}" ${i==m.i?"selected":""}>${c[0]}</option>`).join("")}</select></label>
    <span class="xp">${fmt(CR[m.i][1])} PE ciascuna</span>
    <button class="del" data-dm="${k}" aria-label="Rimuovi creatura">×</button></div>`).join("");
  calc();
}

function calc(){
  const th=[0,0,0,0,0]; let pcs=0;
  party.forEach(p=>{pcs+=p.n;T[p.l].forEach((v,i)=>th[i]+=v*p.n)});
  let count=0,raw=0;
  mons.forEach(m=>{count+=m.q;raw+=CR[m.i][1]*m.q});
  let s=mult(count);
  if(pcs<3)s++; else if(pcs>=6)s--;
  s=Math.max(0,Math.min(STEPS.length-1,s));
  const adj=raw*STEPS[s];
  let lvl=-1; th.forEach((t,i)=>{if(adj>=t)lvl=i});
  const v=$("verdict");
  v.textContent=lvl<0?"Sotto la soglia Facile":NAMES[lvl];
  v.style.color=lvl<0?"var(--c0)":COL[lvl];
  $("calc").textContent=`${fmt(raw)} PE × ${String(STEPS[s]).replace(".",",")} (${count} creature, ${pcs} PG) = ${fmt(adj)} PE corretti`;
  const max=Math.max(th[4]*1.1,adj*1.05)||1;
  $("fill").style.width=Math.min(100,adj/max*100)+"%";
  $("bar").querySelectorAll(".tick").forEach(e=>e.remove());
  th.forEach(t=>{const d=document.createElement("div");d.className="tick";d.style.left=(t/max*100)+"%";$("bar").appendChild(d)});
  $("grid").innerHTML=th.map((t,i)=>`<div class="cell ${i<=lvl?"on":""}" style="--k:${COL[i]}"><span>${NAMES[i]}</span><b>${fmt(t)}</b></div>`).join("");
}


document.addEventListener("input",e=>{
  const t=e.target,f=t.dataset.f; if(!f)return;
  const val=Math.max(1,parseInt(t.value,10)||1);
  if(t.dataset.p!==undefined){party[t.dataset.p][f]=f=="l"?parseInt(t.value,10):Math.min(val,20);}
  else if(t.dataset.m!==undefined){mons[t.dataset.m][f]=f=="i"?parseInt(t.value,10):Math.min(val,99);}
  if(t.tagName=="SELECT"){render();}else{calc();}
});
document.addEventListener("click",e=>{
  const t=e.target;
  if(t.dataset.dp!==undefined&&party.length>1){party.splice(t.dataset.dp,1);render();}
  if(t.dataset.dm!==undefined&&mons.length>1){mons.splice(t.dataset.dm,1);render();}
});
$("addP").onclick=()=>{party.push({n:1,l:5});render();};
$("addM").onclick=()=>{mons.push({i:4,q:1});render();};
render();
</script>
</body>
</html>
